// SPDX-License-Identifier: Apache-2.0
// Bounded byte-packet validator. See the [packet walkthrough](../docs/tooling/packet-walkthrough.md).
module HoldFast.FirstSlice;

public union ValidationError
{
    FramingShort();
    BadMagicOrFlags();
    LengthOutOfBounds();
    ChecksumRejected();
}

public record ValidatedPacket<region 'dst>(
    usize CopiedBytes,
    in<'dst> Span<byte> PayloadView);

public definition Span<byte> MakePacket8(
    usize base,
    byte b0,
    byte b1,
    byte b2,
    byte b3,
    byte b4,
    byte b5,
    byte b6,
    byte b7)
    =>
    let s0 = Span.AllocZeroed(base, 8) in
    let s1 = Span.Write(s0, 0, b0) in
    let s2 = Span.Write(s1, 1, b1) in
    let s3 = Span.Write(s2, 2, b2) in
    let s4 = Span.Write(s3, 3, b3) in
    let s5 = Span.Write(s4, 4, b4) in
    let s6 = Span.Write(s5, 5, b5) in
    let s7 = Span.Write(s6, 6, b6) in
    Span.Write(s7, 7, b7);

public Unit WritePacket8(
    ref Span<byte> pkt,
    byte b0,
    byte b1,
    byte b2,
    byte b3,
    byte b4,
    byte b5,
    byte b6,
    byte b7)
    effects writes(pkt)
    requires pkt.CanRead && pkt.CanWrite && pkt.Length >= 8
    ensures pkt.Base == old(pkt.Base) && pkt.Length == old(pkt.Length) && pkt.CanRead && pkt.CanWrite
    ensures pkt[0] == b0 && pkt[1] == b1 && pkt[2] == b2 && pkt[3] == b3
    ensures pkt[4] == b4 && pkt[5] == b5 && pkt[6] == b6 && pkt[7] == b7
{
    pkt[0] = b0;
    pkt[1] = b1;
    pkt[2] = b2;
    pkt[3] = b3;
    pkt[4] = b4;
    pkt[5] = b5;
    pkt[6] = b6;
    pkt[7] = b7;
}

public definition Span<byte> InhabitedByteSpan()
    =>
    Span.Write(Span.AllocZeroed(0x1000, 8), 0, 0x56);

public theorem LawInhabitedByteCase()
    ensures exists (Span<byte> s) =>
        (s.CanRead && s.CanWrite && s.Length == 8 && s[0] == 0x56) == true
    proof
    {
        assert exists (Span<byte> s) =>
            (s.CanRead && s.CanWrite && s.Length == 8 && s[0] == 0x56) == true
            by InhabitedByteSpan();
    }

public theorem LawAllocZeroedRead(usize base, usize idx)
    ensures (if (idx < 8) Span.AllocZeroed(base, 8)[idx] == 0x00 else true) == true
    proof
    {
        assert (if (idx < 8) Span.AllocZeroed(base, 8)[idx] == 0x00 else true) == true;
    }

public theorem LawReadOverWriteSame(ref Span<byte> s, usize idx, byte val)
    requires s.CanRead && s.CanWrite && idx < s.Length
    ensures (s[idx] == val && s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite) == true
    proof
    {
        s[idx] = val;
        assert (s[idx] == val && s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite) == true;
    }

public theorem LawReadOverWriteOther(ref Span<byte> s, usize writeIdx, usize readIdx, byte val)
    requires s.CanRead && s.CanWrite && writeIdx < s.Length && readIdx < s.Length && writeIdx != readIdx
    ensures (s[writeIdx] == val && s[readIdx] == old(s[readIdx])) == true
    proof
    {
        s[writeIdx] = val;
        assert (s[writeIdx] == val && s[readIdx] == old(s[readIdx])) == true;
    }

public theorem LawLoopFramePreservesDisjointSuffix(ref Span<byte> s, usize bound, usize frameIdx, byte fillByte)
    requires s.CanRead && s.CanWrite
    requires bound <= s.Length
    requires frameIdx >= bound && frameIdx < s.Length
    ensures (s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite && s[frameIdx] == old(s[frameIdx])) == true
    proof
    {
        foreach (let i in 0..bound)
            invariant i <= bound
            invariant s.CanRead && s.CanWrite && s.Base == old(s.Base) && s.Length == old(s.Length)
            invariant s[frameIdx] == old(s[frameIdx])
            decreases bound - i
        {
            s[i] = fillByte;
        }
        assert (s.Base == old(s.Base) && s.Length == old(s.Length) && s.CanRead && s.CanWrite && s[frameIdx] == old(s[frameIdx])) == true;
    }

public theorem LawFillAndFrame(ref Span<byte> s, usize frameIdx, byte fillVal)
    requires s.CanRead && s.CanWrite && s.Length >= 8
    requires frameIdx >= 6 && frameIdx < s.Length
    ensures (s[1] == old(s[1])
        && s[2] == fillVal
        && s[5] == fillVal
        && s[frameIdx] == old(s[frameIdx])) == true
    proof
    {
        Span.Fill(ref s, 2, 4, fillVal);
        assert (s[1] == old(s[1])
            && s[2] == fillVal
            && s[5] == fillVal
            && s[frameIdx] == old(s[frameIdx])) == true;
    }

public theorem LawSymbolicFillFrame(ref Span<byte> s, usize count, usize i)
    requires s.CanRead && s.CanWrite
    requires count <= 1_000_000_000 && 4 + count <= s.Length
    requires i >= 1_000_000_004 && i < s.Length
    ensures s[i] == old(s)[i]
    proof
    {
        Span.Fill(ref s, 4, count, 0);
        assert s[i] == old(s)[i];
    }

public theorem LawSliceMetadataAndRead(in Span<byte> s, usize idx)
    requires s.CanRead && s.Base <= 0xFFFF_0000 && s.Length >= 8 && idx < 3
    ensures
        let sub = Span.Slice(s, 4, 3) in
        (sub.Base == s.Base + 4
            && sub.Length == 3
            && sub.CanRead
            && sub.CanWrite == s.CanWrite
            && sub[idx] == s[4 + idx]) == true
    proof
    {
        let sub = Span.Slice(s, 4, 3);
        assert (sub.Base == s.Base + 4
            && sub.Length == 3
            && sub.CanRead
            && sub.CanWrite == s.CanWrite
            && sub[idx] == s[4 + idx]) == true;
    }

public theorem LawReadOnlyAndInvalidate(in Span<byte> s)
    requires s.CanRead && s.CanWrite
    ensures
        let ro = Span.ReadOnly(s) in
        let inv = Span.Invalidate(s) in
        (ro.CanRead && !ro.CanWrite && !inv.CanRead && !inv.CanWrite) == true
    proof
    {
        let ro = Span.ReadOnly(s);
        let inv = Span.Invalidate(s);
        assert (ro.CanRead && !ro.CanWrite && !inv.CanRead && !inv.CanWrite) == true;
    }

public theorem LawDisjointCopyAndFrame(ref Span<byte> dst, in Span<byte> src, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && src.CanRead
    requires dst.Length >= 8 && src.Length >= 6
    requires Span.Disjoint(dst, src)
    requires frameIdx >= 6 && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst[3] == old(dst[3])
        && dst[4] == src[4]
        && dst[5] == src[5]
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        var dstSub = Span.Slice(dst, 4, 2);
        let srcSub = Span.Slice(src, 4, 2);
        Span.CopyPrefix(ref dstSub, srcSub, 2);
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst[3] == old(dst[3])
            && dst[4] == src[4]
            && dst[5] == src[5]
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public Span<byte> PrepareSliceHeader(ref Span<byte> dst)
    effects writes(dst)
    requires dst.CanRead
    requires dst.CanWrite
    requires dst.Length >= 8
    ensures dst.Length == old(dst.Length)
    ensures result.Length == 4
    ensures !result.CanWrite
{
    foreach (let i in 0..dst.Length)
        invariant i <= dst.Length
        invariant dst.CanRead && dst.CanWrite && dst.Base == old(dst.Base) && dst.Length == old(dst.Length)
        decreases dst.Length - i
    {
        dst[i] = 0x00;
    }
    dst[0] = 0x56;
    dst[3] = 0x01;
    let roView = Span.ReadOnly(Span.Slice(dst, 0, 4));
    return roView;
}

public theorem LawCapacityInvarianceSmall(ref Span<byte> s)
    requires s.CanRead && s.CanWrite && s.Length == 8
    ensures (s.Length == 8 && s[0] == 0x56 && s[3] == 0x01) == true
    proof
    {
        let roView = PrepareSliceHeader(ref s);
        assert (s.Length == 8
            && roView.Length == 4
            && !roView.CanWrite
            && s[0] == 0x56
            && s[3] == 0x01) == true;
    }

public theorem LawCapacityInvarianceLarge(ref Span<byte> s)
    requires s.CanRead && s.CanWrite && s.Length == 1_000_000_000
    ensures (s.Length == 1_000_000_000 && s[0] == 0x56 && s[3] == 0x01) == true
    proof
    {
        let roView = PrepareSliceHeader(ref s);
        assert (s.Length == 1_000_000_000
            && roView.Length == 4
            && !roView.CanWrite
            && s[0] == 0x56
            && s[3] == 0x01) == true;
    }

public definition u8 SpecPacketChecksum(in Span<byte> pkt, u8 rawLen, usize payloadLen)
    requires pkt.CanRead
    requires payloadLen <= 4
    requires 4 + payloadLen <= pkt.Length
    =>
    let c0 = 0x5A ^ rawLen in
    let c1 = if (0 < payloadLen) c0 ^ pkt[4] else c0 in
    let c2 = if (1 < payloadLen) c1 ^ pkt[5] else c1 in
    let c3 = if (2 < payloadLen) c2 ^ pkt[6] else c2 in
    if (3 < payloadLen) c3 ^ pkt[7] else c3;

public definition Result<usize, ValidationError> SpecPacketOutcome(in Span<byte> dst, in Span<byte> pkt)
    requires dst.CanRead && dst.CanWrite && pkt.CanRead
    =>
    if (dst.Length < 8 || pkt.Length < 4 || !Span.Disjoint(dst, pkt))
        Err(FramingShort)
    else if (pkt[0] != 0x56 || pkt[3] != 0x01)
        Err(BadMagicOrFlags)
    else if (usize.From(pkt[1]) > 4
        || 4 + usize.From(pkt[1]) > pkt.Length
        || 4 + usize.From(pkt[1]) > dst.Length)
        Err(LengthOutOfBounds)
    else if (SpecPacketChecksum(in pkt, pkt[1], usize.From(pkt[1])) != pkt[2])
        Err(ChecksumRejected)
    else
        Ok(usize.From(pkt[1]));

public definition bool SpecPacketValid(in Span<byte> dst, in Span<byte> pkt)
    requires dst.CanRead && dst.CanWrite && pkt.CanRead
    => SpecPacketOutcome(in dst, in pkt) is Ok(_);

public definition Result<usize, ValidationError> PacketOutcome<region 'dst>(
    Result<ValidatedPacket<'dst>, ValidationError> actual)
    => match (actual)
    {
        Ok(ValidatedPacket(copied, _)) => Ok(copied),
        Err(reason) => Err(reason)
    };

private Unit CopyPacketToDst(ref Span<byte> dst, in Span<byte> pkt, usize payloadLen)
    requires dst.CanRead
    requires dst.CanWrite
    requires pkt.CanRead
    requires dst.Length >= 8
    requires pkt.Length >= 4
    requires Span.Disjoint(dst, pkt)
    requires payloadLen <= 4
    requires 4 + payloadLen <= pkt.Length
    requires 4 + payloadLen <= dst.Length
{
    foreach (let i in 0..4usize)
        invariant dst.CanRead && dst.CanWrite && dst.Base == old(dst.Base) && dst.Length == old(dst.Length)
    {
        dst[i] = pkt[i];
    }
    var payloadView = Span.Slice(dst, 4, payloadLen);
    let pktPayload = Span.Slice(pkt, 4, payloadLen);
    Span.CopyPrefix(ref payloadView, pktPayload, payloadLen);
}

private u8 ComputePacketChecksum(in Span<byte> pkt, u8 rawLen, usize payloadLen)
    requires pkt.CanRead
    requires payloadLen <= 4
    requires 4 + payloadLen <= pkt.Length
{
    var u8 acc = 0x5A ^ rawLen;
    foreach (let i in 0..4usize)
    {
        if (i < payloadLen)
        {
            acc = acc ^ pkt[4 + i];
        }
    }
    return acc;
}

public Result<ValidatedPacket<'dst>, ValidationError> PrepareAndValidatePacket<region 'dst>(
    ref<'dst> Span<byte> dst,
    in Span<byte> pkt)
    effects writes(dst), reads(pkt)
    requires dst.CanRead
    requires dst.CanWrite
    requires pkt.CanRead
    ensures match (result)
    {
        Ok(ValidatedPacket(copied, payloadView)) =>
            copied <= 4 && payloadView.Length == copied && payloadView.CanRead && !payloadView.CanWrite,
        Err(_) =>
            dst.Length == old(dst.Length) && dst.CanRead && dst.CanWrite
    }
    ensures SpecPacketValid(in old(dst), in pkt) <==> (result is Ok(_))
    ensures (result is Ok(_)) ==> (dst[0] == pkt[0] && dst[1] == pkt[1] && dst[2] == pkt[2] && dst[3] == pkt[3])
    ensures (result is Err(FramingShort)) ==> dst == old(dst)
    ensures ((result is Err(_)) && !(result is Err(FramingShort)) && dst.Length >= 8) ==>
        (dst[0] == 0x00 && dst[1] == 0x00 && dst[2] == 0x00 && dst[3] == 0x00
        && dst[4] == 0x00 && dst[5] == 0x00 && dst[6] == 0x00 && dst[7] == 0x00)
    ensures ((result is Ok(_)) && dst.Length >= 8 && pkt.Length >= 4 && usize.From(pkt[1]) <= 4
        && 4 + usize.From(pkt[1]) <= dst.Length) ==> result == Ok(ValidatedPacket(
            usize.From(pkt[1]), in Span.ReadOnly(Span.Slice(dst, 4, usize.From(pkt[1])))))
    ensures (forall (usize i) => match (result)
    {
        Ok(ValidatedPacket(copied, _)) =>
            if (copied <= 4 && i >= 4 && i < 4 + copied && i < dst.Length && i < pkt.Length) dst[i] == pkt[i] else true,
        Err(_) => true
    })
    ensures (forall (usize i) => match (result)
    {
        Ok(ValidatedPacket(copied, _)) =>
            if (copied <= 4 && i >= 4 + copied && i >= 4 && i < 8 && i < dst.Length) dst[i] == 0x00 else true,
        Err(_) => true
    })
    ensures (forall (usize i) => (i >= 8 && i < dst.Length && i < old(dst.Length)) ==> dst[i] == old(dst)[i])
    ensures PacketOutcome(result) == SpecPacketOutcome(in old(dst), in pkt)
{
    if (dst.Length < 8 || pkt.Length < 4 || !Span.Disjoint(dst, pkt))
    {
        return Err(FramingShort);
    }
    Span.Fill(ref dst, 0, 8, 0x00);
    let magic = pkt[0];
    let rawLen = pkt[1];
    let expectedChecksum = pkt[2];
    let flags = pkt[3];
    let payloadLen = usize.From(rawLen);
    if (magic != 0x56 || flags != 0x01)
    {
        return Err(BadMagicOrFlags);
    }
    if (payloadLen > 4 || 4 + payloadLen > pkt.Length || 4 + payloadLen > dst.Length)
    {
        return Err(LengthOutOfBounds);
    }
    CopyPacketToDst(ref dst, in pkt, payloadLen);
    let actualChecksum = ComputePacketChecksum(in pkt, rawLen, payloadLen);
    if (actualChecksum != expectedChecksum)
    {
        Span.Fill(ref dst, 0, 8, 0x00);
        return Err(ChecksumRejected);
    }
    let payloadView = Span.ReadOnly(Span.Slice(dst, 4, payloadLen));
    return Ok(ValidatedPacket(payloadLen, in payloadView));
}

public theorem ValidateEmptyPacketOk(ref Span<byte> dst, in Span<byte> pkt, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Base <= 0xFFFF_0000 && dst.Length >= 8
    requires pkt.CanRead && pkt.Length >= 4
    requires Span.Disjoint(dst, pkt)
    requires pkt[0] == 0x56 && pkt[1] == 0x00 && pkt[2] == 0x5A && pkt[3] == 0x01
    requires frameIdx >= 8 && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst.CanRead
        && dst.CanWrite
        && dst[0] == 0x56
        && dst[1] == 0x00
        && dst[2] == 0x5A
        && dst[3] == 0x01
        && dst[4] == 0x00
        && dst[7] == 0x00
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (SpecPacketValid(in old(dst), in pkt)
            && match (outcome)
            {
                Ok(ValidatedPacket(copied, payloadView)) =>
                    copied == 0
                    && payloadView.Base == dst.Base + 4
                    && payloadView.Length == 0
                    && payloadView.CanRead
                    && !payloadView.CanWrite,
                Err(_) => false
            }) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst.CanRead
            && dst.CanWrite
            && dst[0] == 0x56
            && dst[1] == 0x00
            && dst[2] == 0x5A
            && dst[3] == 0x01
            && dst[4] == 0x00
            && dst[7] == 0x00
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem ValidateFullPacketOk(
    ref Span<byte> dst,
    in Span<byte> pkt,
    byte b0,
    byte b1,
    byte b2,
    byte b3,
    usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Base <= 0xFFFF_0000 && dst.Length >= 8
    requires pkt.CanRead && pkt.Length >= 8
    requires Span.Disjoint(dst, pkt)
    requires pkt[0] == 0x56 && pkt[1] == 0x04 && pkt[3] == 0x01
    requires pkt[4] == b0 && pkt[5] == b1 && pkt[6] == b2 && pkt[7] == b3
    requires pkt[2] == ((0x5A ^ 0x04) ^ (b0 ^ b1 ^ b2 ^ b3))
    requires frameIdx >= 8 && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst[4] == b0
        && dst[5] == b1
        && dst[6] == b2
        && dst[7] == b3
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (SpecPacketValid(in old(dst), in pkt)
            && match (outcome)
            {
                Ok(ValidatedPacket(copied, payloadView)) =>
                    copied == 4
                    && payloadView.Base == dst.Base + 4
                    && payloadView.Length == 4
                    && payloadView.CanRead
                    && !payloadView.CanWrite
                    && payloadView[0] == b0
                    && payloadView[1] == b1
                    && payloadView[2] == b2
                    && payloadView[3] == b3,
                Err(_) => false
            }) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst[4] == b0
            && dst[5] == b1
            && dst[6] == b2
            && dst[7] == b3
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem ValidatePartialPacketScrubsStaleAndTrailingBytes(
    ref Span<byte> dst,
    in Span<byte> pkt,
    byte b0,
    byte b1,
    usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8
    requires pkt.CanRead && pkt.Length >= 6
    requires Span.Disjoint(dst, pkt)
    requires pkt[0] == 0x56 && pkt[1] == 0x02 && pkt[3] == 0x01
    requires pkt[4] == b0 && pkt[5] == b1
    requires pkt[2] == ((0x5A ^ 0x02) ^ (b0 ^ b1))
    requires frameIdx >= 8 && frameIdx < dst.Length
    ensures (dst[4] == b0
        && dst[5] == b1
        && dst[6] == 0x00
        && dst[7] == 0x00
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (SpecPacketValid(in old(dst), in pkt)
            && match (outcome)
            {
                Ok(ValidatedPacket(copied, payloadView)) =>
                    copied == 2
                    && payloadView.Length == 2
                    && payloadView.CanRead
                    && !payloadView.CanWrite
                    && payloadView[0] == b0
                    && payloadView[1] == b1,
                Err(_) => false
            }) == true;
        assert (dst[4] == b0
            && dst[5] == b1
            && dst[6] == 0x00
            && dst[7] == 0x00
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem RejectFramingShort(ref Span<byte> dst, in Span<byte> pkt, usize idx)
    requires dst.CanRead && dst.CanWrite
    requires pkt.CanRead && pkt.Length < 4
    requires idx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst.CanWrite
        && dst[idx] == old(dst[idx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(FramingShort))) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst.CanWrite
            && dst[idx] == old(dst[idx])) == true;
    }

public theorem RejectBadMagic(ref Span<byte> dst, in Span<byte> pkt, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8
    requires pkt.CanRead && pkt.Length >= 4
    requires Span.Disjoint(dst, pkt)
    requires pkt[0] != 0x56
    requires frameIdx >= 8 && frameIdx < dst.Length
    ensures (dst[0] == 0x00
        && dst[7] == 0x00
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(BadMagicOrFlags))) == true;
        assert (dst[0] == 0x00
            && dst[7] == 0x00
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem RejectLengthOutOfBounds(ref Span<byte> dst, in Span<byte> pkt, usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8
    requires pkt.CanRead && pkt.Length >= 4
    requires Span.Disjoint(dst, pkt)
    requires pkt[0] == 0x56 && pkt[3] == 0x01 && pkt[1] > 0x04
    requires frameIdx >= 8 && frameIdx < dst.Length
    ensures (dst.Length == old(dst.Length)
        && dst[0] == 0x00
        && dst[7] == 0x00
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(LengthOutOfBounds))) == true;
        assert (dst.Length == old(dst.Length)
            && dst[0] == 0x00
            && dst[7] == 0x00
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }

public theorem RejectChecksumScrubsDestinationAndRestores(
    ref Span<byte> dst,
    in Span<byte> pkt,
    byte b0,
    byte b1,
    usize frameIdx)
    requires dst.CanRead && dst.CanWrite && dst.Length >= 8
    requires pkt.CanRead && pkt.Length >= 6
    requires Span.Disjoint(dst, pkt)
    requires pkt[0] == 0x56 && pkt[1] == 0x02 && pkt[3] == 0x01
    requires pkt[4] == b0 && pkt[5] == b1
    requires pkt[2] != ((0x5A ^ 0x02) ^ (b0 ^ b1))
    requires frameIdx >= 8 && frameIdx < dst.Length
    ensures (dst.Base == old(dst.Base)
        && dst.Length == old(dst.Length)
        && dst.CanWrite
        && dst[0] == 0x00
        && dst[4] == 0x00
        && dst[5] == 0x00
        && dst[7] == 0x00
        && dst[frameIdx] == old(dst[frameIdx])) == true
    proof
    {
        let outcome = PrepareAndValidatePacket(ref dst, in pkt);
        assert (!SpecPacketValid(in old(dst), in pkt)
            && (outcome is Err(ChecksumRejected))) == true;
        assert (dst.Base == old(dst.Base)
            && dst.Length == old(dst.Length)
            && dst.CanWrite
            && dst[0] == 0x00
            && dst[4] == 0x00
            && dst[5] == 0x00
            && dst[7] == 0x00
            && dst[frameIdx] == old(dst[frameIdx])) == true;
    }
