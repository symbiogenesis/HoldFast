module Weights.Measure;

public record Weight(Nat Units);

public interface Measured<T>
{
    Nat Measure(T value);
}

public impl Measured<Weight>
{
    public definition Nat Measure(Weight value) => value.Units + 2;
}

public definition Weight Make(Nat local as units) => Weight(local);
