// Required-static inputs can determine a multiplier for runtime samples.
module Constants;

/// Squares a natural number in either a static evaluation or an ordinary call.
public const Nat Square(Nat value) => value * value;

/// The gain used by Process and StaticResult.
public const Nat Gain = 4;

/// Multiplies a runtime sample by the square of the required-static gain.
public Nat Scale(const Nat gain, Nat sample)
{
    const Nat multiplier = Square(gain);
    return multiplier * sample;
}

/// Passes the required-static gain and runtime sample to Scale.
public Nat Forward(const Nat gain, Nat sample) => Scale(gain: gain, sample: sample);

/// Multiplies a sample by the configured gain squared.
public Nat Process(Nat sample) => Forward(gain: Gain, sample: sample);

/// The square of the configured gain, evaluated during compilation.
public const Nat StaticResult = Square(Gain);

/// Squares an input that can be supplied at runtime.
public Nat RuntimeSquare(Nat value) => Square(value);
