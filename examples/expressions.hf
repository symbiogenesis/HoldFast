module Expressions;

/// Subtracts used from total, returning zero when used exceeds total.
public Nat Remaining(Nat total, Nat used) => Nat.SaturatingSub(total, used);

/// Allows an unpaused request with a value from 3 through 9 or a value of 20.
public bool Allowed(Nat value, bool paused)
{
    return !paused && (value >= 3 && value < 10 || value == 20);
}

/// Tests whether the Boolean value changed.
public bool Changed(bool before, bool after) => before != after;

/// Tests whether the total strictly exceeds the used amount.
public bool HasRoom(Nat total, Nat used) => total > used;

/// Scales the value, then subtracts four if the result is large enough. Otherwise returns zero.
public Nat Adjusted(Nat value)
{
    let scaled = value * 3 + 2;
    if (4 <= scaled)
    {
        return scaled - 4;
    }
    else
    {
        return 0;
    }
}

/// Counts complete groups, returning zero when the group size is zero.
public Nat Groups(Nat count, Nat size)
{
    if (size != 0)
    {
        return count / size;
    }
    else
    {
        return 0;
    }
}

/// Counts ungrouped items, returning the full count when the group size is zero.
public Nat Leftover(Nat count, Nat size)
{
    if (size != 0)
    {
        return count % size;
    }
    else
    {
        return count;
    }
}

/// Division and remainder share multiplication's left-to-right precedence.
public Nat Grouped(Nat count) => count / 3 % 4 * 2;
