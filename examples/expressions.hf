module Expressions;

/// Returns zero when the used amount exceeds the total.
public Nat Remaining(Nat total, Nat used) => Nat.SaturatingSub(total, used);

/// Negation binds tighter than comparisons, conjunction, then disjunction.
public bool Allowed(Nat value, bool paused)
{
    return !paused && (value >= 3 && value < 10 || value == 20);
}

/// Equality and inequality compare two values of the same type.
public bool Changed(bool before, bool after) => before != after;

/// Reversed comparisons still evaluate their left operand first.
public bool HasRoom(Nat total, Nat used) => total > used;

/// Subtracts the fixed adjustment when the scaled value covers it.
public Nat Adjusted(Nat value)
{
    let scaled = value * 3 + 2;
    if (4 <= scaled)
    {
        return scaled - 4;
    }
    else
    {
        return 0;
    }
}

/// A zero size permits no complete groups.
public Nat Groups(Nat count, Nat size)
{
    if (size != 0)
    {
        return count / size;
    }
    else
    {
        return 0;
    }
}

/// At size zero every item stays ungrouped.
public Nat Leftover(Nat count, Nat size)
{
    if (size != 0)
    {
        return count % size;
    }
    else
    {
        return count;
    }
}

/// Division and remainder share multiplication's left-to-right precedence.
public Nat Grouped(Nat count) => count / 3 % 4 * 2;
