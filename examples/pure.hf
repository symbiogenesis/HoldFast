// Functions over mathematical naturals and Booleans.
module Oracle;

/// Computes the cube of a natural number.
public const Nat Cube(Nat x,) => x * x * x;

/// The base for the upper bound in Choose.
public const Nat Base = 2;

/// Tests whether Cube(x + 1) is at most Cube(Base) + 1 when flag is true.
/// When flag is false, tests whether Cube(x + 1) equals zero.
public bool Choose(bool flag, Nat x)
{
    let Nat y = Cube(x: x + 1,);
    if (flag == true)
    {
        const Nat limit = Cube(x: Base) + 1;
        return y <= limit;
    }
    else
    {
        const Nat limit = 0;
        if (y == limit)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
}
