module MultiRegionDisambiguation;

public in<'a> byte SelectFirst<region 'a, region 'b>(
    in<'a> byte first,
    in<'b> byte second)
    requires (Outlives<'a, 'b>)
{
    let _unused = second;
    return first;
}

public in<'b> byte CovariantOutlives<region 'a, region 'b>(in<'a> byte first)
    requires (Outlives<'a, 'b>)
{
    return first;
}
