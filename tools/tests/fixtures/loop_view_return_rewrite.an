import Std.Collections.Vec.module, type
import Std.Fail.abort_on_fail

inspect_and_clear (r0: mut Vec U8) (r1: mut Vec U8) (r2: mut Vec U8) (r3: ref Vec U8) (n: Usz): Maybe U8 can Panic, Mutate 'r0, Mutate 'r1, Mutate 'r2 =
    if n <= 3 then
        selected = r3.[0]
        for j in 0usz .. n do
            if j == 0 then Vec.clear r0
            else if j == 1 then Vec.clear r1
            else Vec.clear r2
        Some selected.*
    else None

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do
    for n in 0usz .. 8 do
        for variant in 0usz .. 2 do
            var r0 = Vec.of [1u8, 2u8]
            var r1 = Vec.of [3u8, 4u8]
            var r2 = Vec.of [5u8, 6u8]
            r3 = Vec.of [7u8, 8u8]
            observed = inspect_and_clear r0 r1 r2 r3 n
            if n <= 3 then
                assert <| observed is Some 7u8
                if n >= 1 then assert <| Vec.is_empty r0 else assert <| r0 == Vec.of [1u8, 2u8]
                if n >= 2 then assert <| Vec.is_empty r1 else assert <| r1 == Vec.of [3u8, 4u8]
                if n >= 3 then assert <| Vec.is_empty r2 else assert <| r2 == Vec.of [5u8, 6u8]
            else
                assert <| observed is None
                assert <| r0 == Vec.of [1u8, 2u8]
                assert <| r1 == Vec.of [3u8, 4u8]
                assert <| r2 == Vec.of [5u8, 6u8]
            assert <| r3 == Vec.of [7u8, 8u8]
            assert <| variant < 2usz
    println "verified 16 cases"
